{
  "name": "bouncer",
  "version": "0.5.1",
  "description": "Process Bouncer: makes heavy builds, tests and agent jobs wait their turn so your machine never runs out of memory.",
  "private": true,
  "type": "module",
  "bin": {
    "bouncer": "dist/bouncer"
  },
  "scripts": {
    "dev": "bun src/main.ts",
    "build": "bun build src/main.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile dist/bouncer",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "install-local": "bun run build && ./dist/bouncer install",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "tsc --noEmit && biome check . && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/griphaugland/bouncer"
  }
}
