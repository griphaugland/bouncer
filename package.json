{
  "name": "bouncer",
  "version": "0.1.0",
  "description": "Process Bouncer: makes heavy builds, tests and agent jobs wait their turn so your machine never runs out of memory.",
  "private": true,
  "type": "module",
  "bin": {
    "bouncer": "dist/bouncer"
  },
  "scripts": {
    "dev": "bun src/main.ts",
    "build": "bun build src/main.ts --compile --outfile dist/bouncer",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "install-local": "bun run build && ./dist/bouncer install"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
